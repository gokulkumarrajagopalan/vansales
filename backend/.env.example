PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://username:password@localhost:5432/vansales
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Tally Integration Credentials
TALLY_API_KEY=your_tally_api_key
TALLY_USER_ID=your_tally_user_id
TALLY_PASSWORD=your_tally_password
TALLY_TOKEN_EXPIRES_IN=24h

# Company default
DEFAULT_COMPANY_ID=1
DEFAULT_COMPANY_CODE=COMP001
