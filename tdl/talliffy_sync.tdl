;; =============================================================================
;; Talliffy Van Sales & Distribution ERP — TallyPrime TDL Connector
;; File: talliffy_sync.tdl
;; Compatible with: TallyPrime Release 1.0 through 4.x / Tally.ERP 9
;; =============================================================================

[#Menu: Gateway of Tally]
    Add: Key Item: Before: @@locQuit : "Talliffy Van Sales Sync" : "Y" : Menu : TalliffySyncMenu

[Menu: TalliffySyncMenu]
    Title: "Talliffy Van Sales & Distribution Gateway"
    Item: "1. Push All Masters to Talliffy (Godowns, Parties, Stock)" : Call : ExportMastersToTalliffy
    Item: "2. Pull Van Sales Invoices into Tally"                     : Call : ImportSalesVouchersFromTalliffy
    Item: "3. Pull Van Payment Receipts into Tally"                    : Call : ImportReceiptsFromTalliffy
    Item: "4. Test Talliffy API Server Connection"                    : Call : TestTalliffyConnection
    Item: "5. Configure Talliffy API Endpoint"                        : Modify : TalliffyConfigReport

;; =============================================================================
;; Configuration Storage & Variables (Zero-Password Company API Token)
;; =============================================================================
[System: Variable]
    TalliffyApiUrl   : "http://66.116.232.161:8088/api/tally"
    TalliffyApiToken : "tal_live_cmp12_..."

[Variable: TalliffyApiUrl]
    Type: String
    Persistent: Yes

[Variable: TalliffyApiToken]
    Type: String
    Persistent: Yes

;; =============================================================================
;; Configuration Form
;; =============================================================================
[Report: TalliffyConfigReport]
    Form: TalliffyConfigForm
    Title: "Talliffy API Gateway Settings"

[Form: TalliffyConfigForm]
    Part: TalliffyConfigPart
    Width: 60% Screen
    Height: 35% Screen

[Part: TalliffyConfigPart]
    Line: TalliffyUrlLine, TalliffyTokenLine

[Line: TalliffyUrlLine]
    Field: Medium Prompt, TalliffyUrlField
    Local: Field: Medium Prompt: Set as: "Talliffy Backend API URL:"

[Field: TalliffyUrlField]
    Use: Name Field
    Modifies: TalliffyApiUrl
    Width: 40
    Set as: ##TalliffyApiUrl

[Line: TalliffyTokenLine]
    Field: Medium Prompt, TalliffyTokenField
    Local: Field: Medium Prompt: Set as: "Company API Token:"

[Field: TalliffyTokenField]
    Use: Name Field
    Modifies: TalliffyApiToken
    Width: 50
    Set as: ##TalliffyApiToken

;; =============================================================================
;; Collections for Extraction (Godowns, Sundry Debtors/Parties, Stock Items)
;; =============================================================================
[Collection: TalliffyGodownsColl]
    Type: Godown
    Fetch: Name, Guid, Address

[Collection: TalliffyPartiesColl]
    Type: Ledger
    Child of: $$GroupSundryDebtors
    Fetch: Name, Parent, OpeningBalance, ClosingBalance, PartyGSTIN, MobileNo, Email, Address, Guid

[Collection: TalliffyStockItemsColl]
    Type: StockItem
    Fetch: Name, BaseUnits, Category, HSNCode, OpeningBalance, OpeningRate, OpeningValue, Guid

;; =============================================================================
;; Functions: Communication and Sync
;; =============================================================================
[Function: TestTalliffyConnection]
    Variable: vToken : String
    00 : MsgBox: "Talliffy Gateway" : "Connecting to Talliffy Server: " + ##TalliffyApiUrl + "/Ping"
    10 : Return

[Function: ExportMastersToTalliffy]
    00 : MsgBox: "Talliffy Sync" : "Extracting Godowns, Sundry Debtors & Stock Catalog for Talliffy DB..."
    10 : Return

[Function: ImportSalesVouchersFromTalliffy]
    00 : MsgBox: "Talliffy Sync" : "Contacting Talliffy Gateway for Pending Van Sales Invoices..."
    10 : Return

[Function: ImportReceiptsFromTalliffy]
    00 : MsgBox: "Talliffy Sync" : "Contacting Talliffy Gateway for Pending Cash Drawer Receipts..."
    10 : Return
