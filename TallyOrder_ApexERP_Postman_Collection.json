            },
            "url": { "raw": "{{baseUrl}}/settings/permissions", "host": ["{{baseUrl}}"], "path": ["settings", "permissions"] }
          }
        },
        {
          "name": "List All Permissions (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/settings/permissions", "host": ["{{baseUrl}}"], "path": ["settings", "permissions"] }
          }
        }
      ]
    },
    {
      "name": "8. Live Van GPS Tracking",
      "item": [
        {
          "name": "Telemetry Ingest (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salesman_user_id\": 48,\n  \"latitude\": 13.045,\n  \"longitude\": 77.608,\n  \"speed_kmh\": 45,\n  \"heading_deg\": 60,\n  \"battery_pct\": 88,\n  \"is_moving\": true,\n  \"cmp_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/tracking/ping", "host": ["{{baseUrl}}"], "path": ["tracking", "ping"] }
          }
        },
        {
          "name": "Get Live Fleet Positions (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/tracking/live", "host": ["{{baseUrl}}"], "path": ["tracking", "live"] }
          }
        },
        {
          "name": "Get Historical Breadcrumb Trail (GET)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/tracking/history/48", "host": ["{{baseUrl}}"], "path": ["tracking", "history", "48"] }
          }
        },
        {
          "name": "Simulate Motion Step (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salesman_user_id\": 48\n}"
            },
            "url": { "raw": "{{baseUrl}}/tracking/simulate-step", "host": ["{{baseUrl}}"], "path": ["tracking", "simulate-step"] }
          }
        }
      ]
    }
  ]
}
